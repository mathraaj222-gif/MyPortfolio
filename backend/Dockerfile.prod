# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.prod — Used by Elastic Beanstalk deployments
#
# This image expects the TypeScript to be PRE-COMPILED (dist/ included in ZIP).
# TypeScript compilation happens in GitHub Actions BEFORE packaging.
# This keeps EB deploys fast and lean — no dev tools needed at runtime.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install ONLY production dependencies (skips devDependencies like typescript)
COPY package*.json ./
RUN npm ci --omit=dev

# Generate Prisma client (needs the schema)
COPY prisma ./prisma/
RUN npx prisma generate

# Copy pre-compiled application (built by GitHub Actions before packaging)
COPY dist ./dist

# Environment variable placeholders — set real values in EB Console
ENV DATABASE_URL=""
ENV SUPABASE_URL=""
ENV SUPABASE_ANON_KEY=""
ENV FRONTEND_URL=""
ENV PORT=5000

EXPOSE $PORT

# Start the app — entry point is dist/server.js
CMD ["npm", "start"]
